# Environment Configuration
PROJECT_NAME="ExpiryOS"
ENVIRONMENT="development"
SECRET_KEY="super-secret-dev-jwt-key-for-expiry-os-pharmacy-saas-2026"

# Database Configuration
# For local standalone dev with SQLite:
DATABASE_URL="sqlite+aiosqlite:///./expiryos.db"
POSTGRES_RLS_ENABLED="false"

# For PostgreSQL with Row-Level Security:
# DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword2026@localhost:5432/expiryos"
# POSTGRES_RLS_ENABLED="true"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Notifications (Console mock generates instant wa.me click-to-chat links)
WHATSAPP_PROVIDER="console"
WHATSAPP_API_TOKEN="mock_whatsapp_token"
WHATSAPP_PHONE_NUMBER_ID="mock_phone_id"
